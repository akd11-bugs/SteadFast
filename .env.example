# Postgres connection string — set via `prisma postgres link` (Prisma Postgres)
# or point at your own Postgres instance
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Anthropic API for LLM-driven skill runs (28 of 30 skills)
ANTHROPIC_API_KEY=""

# Optional — the 30 skills are bundled in skills-library/, so this is only
# needed to point at a different loion
# SKILL_LIBRARY_PATH="/absolute/path/to/skill-library"

# Default Claude model for skill runs
ANTHROPIC_MODEL="claude-sonnet-4-5"

# SMTP — direct email send (lead dialog, /services/email)
# For Gmail/Google Workspace: enable 2-Step Verifiion, then generate an
# App Password at myaccount.google.com/security Use that, not your real password
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="you@yourdomain.com"
SMTP_PASS=""
EMAIL_FROM="LRM_blu <you@yourdomain.com>"

# Auth — generate with `openssl rand -base64 32`
AUTH_SECRET=""

# Optional — Google sign-in alongside email+password. Create an OAuth Client
# ID (Web application) in Google Cloud Console, with an Authorized redirect
# URI of `<your-deployed-url>/api/auth/callback/google` (and
# `http://localhost:3000/api/auth/callback/google` for local dev). Leave both
# blank to disable Google sign-in entirely — the login page hides the button.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Required to let a user configure their own outbound-email app password
# (Settings → Email) and to power workflow-rule email actions — secrets are
# encrypted at rest (AES-256-GCM) with this key before being stored.
# Generate with `openssl rand -base64 32`. Rotating it invalidates every
# already-saved personal email credential (users would need to re-enter them).
CREDENTIAL_ENCRYPTION_KEY=""

# Automated lead intake from a Google Sheet — POST /api/cron/sync-leads-sheet
# is meant to be hit periodically by an external scheduler (see
# .github/workflows/sync-leads-sheet.yml), authenticated the same way as
# DAILY_REPORT_API_KEY below. Leave CRON_SYNC_API_KEY blank to disable the
# route (it returns 503). Generate with `openssl rand -base64 32`. Which
# sheet to read, its range, and the default owner for unmatched rows are all
# configured per-org from Settings → Google Sheet lead sync, not env vars —
# each org admin pastes their own sheet's ID there.
CRON_SYNC_API_KEY=""

# A Google Cloud service account with "Viewer" access, shared across every
# org's connected sheet (Google Sheets API must be enabled on the GCP
# project). Each org admin shares their own sheet with this one address from
# Settings, the same way they'd invite a collaborator.
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY is the multiline "private_key" field from
# the downloaded service-account JSON key — paste it with its literal `\n`
# sequences intact (do not convert them to real newlines).
#
# The same credential also authenticates the business-card scan feature's
# Cloud Vision (OCR) and Cloud Natural Language (company/contact-name
# extraction) calls — both APIs must be enabled on the GCP project too, not
# just Sheets, or those two calls 403.
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=""

# Daily rep-wise activity summary emailed to every active admin —
# POST /api/cron/daily-activity-report, meant to be hit once a day by an
# external scheduler (see .github/workflows/daily-activity-report.yml),
# authenticated the same way as CRON_SYNC_API_KEY above. Leave blank to
# disable the route (it returns 503). Generate with `openssl rand -base64 32`.
DAILY_REPORT_API_KEY=""

# Live whiteboard presence (cursors, "X is editing this note") — powered by
# Liveblocks. Create a free project at liveblocks.io, copy its secret key
# (starts "sk_") from Dashboard -> API keys. Leave blank to disable: the
# whiteboard still works, it just won't show other people's live cursors.
LIVEBLOCKS_SECRET_KEY=""
# ---- White-label branding ----
# Product name shown in the UI, page titles and marketing copy. Set this per
# deployment to rebrand without a code change. Defaults to "Steadfast".
# Per-ORG logos and accent colours are stored on the Organization row instead
# (see components/branding/OrgLogo.tsx) and need no env var.
NEXT_PUBLIC_BRAND_NAME=Steadfast

# ---- Previously undocumented, required in production ----
# HMAC key for the rep PIN session cookie (lib/repSession.ts). The app THROWS
# on any rep login if this is unset, so it must be present before launch.
# Generate with: openssl rand -base64 32
REP_SESSION_SECRET=""

# Canonical origin for links in admin emails (join-request approvals). Falls
# back to the request Origin header, which is attacker-influenced, so set it.
ADMIN_ORIGIN="https://your-domain.com"

# Neon Auth. NEON_AUTH_COOKIE_SECRET signs the session cookie; rotating it
# logs everyone out. BASE_URL only needs setting for a non-default endpoint.
NEON_AUTH_COOKIE_SECRET=""
NEON_AUTH_BASE_URL=""

# Absolute path to the 30-skill library. Defaults to ./skills-library.
SKILL_LIBRARY_PATH=""
